	search.FocusLost:Connect(function()
		tween(searchStroke, { Color = theme.Stroke })
	end)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		self.Query = search.Text
		for _, t in ipairs(self.Tabs) do
			t:_refresh()
		end
		local active
		for _, t in ipairs(self.Tabs) do
			if t.Active then active = t end
		end
		if self.Query ~= "" and active and active.MatchCount == 0 then
			for _, t in ipairs(self.Tabs) do
				if t.MatchCount > 0 then
					self:SelectTab(t)
					break
				end
			end
		end
	end)

	-- Player footer
	local footer = create("Frame", {
		Position = UDim2.new(0, 0, 1, -52),
		Size = UDim2.new(1, -1, 0, 52),
		BackgroundTransparency = 1,
		Parent = self.Sidebar,
	})
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = theme.Stroke,
		BorderSizePixel = 0,
		Parent = footer,
	})
	local avatar = create("ImageLabel", {
		Position = UDim2.fromOffset(12, 11),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = theme.Element,
		Parent = footer,
	}, { round() })
	self.FooterName = newLabel(footer, player.DisplayName, {
		Position = UDim2.fromOffset(50, 9),
		Size = UDim2.new(1, -58, 0, 18),
		TextSize = 13,
		Font = theme.FontBold,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	self.FooterUser = newLabel(footer, "@" .. player.Name, {
		Position = UDim2.fromOffset(50, 27),
		Size = UDim2.new(1, -58, 0, 15),
		TextSize = 11,
		TextColor3 = theme.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(
				player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48
			)
		end)
		if ok and avatar.Parent then
			avatar.Image = img
		end
	end)

	-- Content
	self.Content = create("Frame", {
		Position = UDim2.fromOffset(150, 40),
		Size = UDim2.new(1, -150, 1, -40),
		BackgroundTransparency = 1,
		Parent = self.Main,
	})

	-- Notifications
	self.NotifyHolder = create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(280, 500),
		BackgroundTransparency = 1,
		Parent = self.Gui,
	}, {
		create("UIListLayout", {
			Padding = UDim.new(0, 8),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Keyboard toggle (rebindable through self.ToggleKey)
	table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and self.ToggleKey and input.KeyCode == self.ToggleKey then
			self:SetVisible(not self.Visible)
		end
	end))

	-- Resize grip (bottom-right corner)
	if options.Resizable ~= false then
		local grip = create("Frame", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -2, 1, -2),
			Size = UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			ZIndex = 10,
			Parent = self.Main,
		})
		for _, pos in ipairs({ Vector2.new(13, 13), Vector2.new(8, 13), Vector2.new(13, 8) }) do
			create("Frame", {
				Position = UDim2.fromOffset(pos.X, pos.Y),
				Size = UDim2.fromOffset(3, 3),
				BackgroundColor3 = theme.SubText,
				BackgroundTransparency = 0.4,
				BorderSizePixel = 0,
				ZIndex = 10,
				Parent = grip,
			}, { round() })
		end
		local resizing, rStart, rSize, rPos = false, nil, nil, nil
		grip.InputBegan:Connect(function(input)
			if isPointer(input) then
				resizing = true
				rStart = input.Position
				rSize = self.Size
				rPos = self.Root.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
					end
				end)
			end
		end)
		table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
			if resizing and isMove(input) and not self.Minimized then
				local sc = uiScale.Scale
				local d = (input.Position - rStart) / sc
				local w = math.clamp(rSize.X.Offset + d.X, 460, 900)
				local h = math.clamp(rSize.Y.Offset + d.Y, 300, 700)
				self.Size = UDim2.fromOffset(w, h)
				self.Root.Size = self.Size
				self.Root.Position = UDim2.new(rPos.X.Scale, rPos.X.Offset + (w - rSize.X.Offset) * sc / 2, rPos.Y.Scale, rPos.Y.Offset)
			end
		end))
	end

	-- Floating toggle button (draggable), shown on touch devices by default
	local showOrb = options.ToggleButton
	if showOrb == nil then
		showOrb = UserInputService.TouchEnabled
	end
	if showOrb then
		local orb = create("TextButton", {
			Name = "ToggleButton",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 14, 0.5, 0),
			Size = UDim2.fromOffset(46, 46),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Text = "",
			AutoButtonColor = false,
			Parent = self.Gui,
		}, { round(), gradient(theme.AccentDark, theme.Accent, 45), stroke(theme.Accent, 1) })
		for i = 0, 2 do
			create("Frame", {
				Position = UDim2.fromOffset(14, 15 + i * 7),
				Size = UDim2.fromOffset(18, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Parent = orb,
			}, { round() })
		end
		makeDraggable(orb, orb, self.Connections)
		local downPos
		orb.InputBegan:Connect(function(input)
			if isPointer(input) then downPos = input.Position end
		end)
		orb.Activated:Connect(function(input)
			if downPos and input and (input.Position - downPos).Magnitude < 8 then
				self:SetVisible(not self.Visible)
			end
		end)
	end

	if self.Loading then
		-- Window stays hidden until the splash screen finishes
		local intro = type(options.Intro) == "table" and table.clone(options.Intro) or {}
		local userCallback = intro.OnFinished
		intro.Title = intro.Title or options.Title
		intro.OnFinished = function()
			self.Loading = false
			self:SetVisible(true)
			if userCallback then
				task.spawn(userCallback)
			end
		end
		self.Splash = UILibrary.Splash(intro)
	else
		self:SetVisible(true)
	end
	return self
end

function UILibrary:SetVisible(state)
	if self.Loading then return end
	self.Visible = state
	self.Token += 1
	local token = self.Token
	if state then
		self.Root.Visible = true
		self.Pop.Scale = 0.94
		tween(self.Pop, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
		tween(self.Main, { GroupTransparency = 1 - self.Opacity }, 0.3)
		tween(self.Shadow, { ImageTransparency = 0.55 }, 0.3)
	else
		tween(self.Pop, { Scale = 0.96 }, 0.2)
		tween(self.Main, { GroupTransparency = 1 }, 0.2)
		tween(self.Shadow, { ImageTransparency = 1 }, 0.2)
		task.delay(0.2, function()
			if self.Token == token then
				self.Root.Visible = false
			end
		end)
	end
end

function UILibrary:SetMinimized(state)
	self.Minimized = state
	local target = state and UDim2.new(self.Size.X.Scale, self.Size.X.Offset, 0, 40) or self.Size
	tween(self.Root, { Size = target }, 0.25, Enum.EasingStyle.Quint)
end

function UILibrary:Destroy()
	if self.Splash then
		self.Splash:Destroy()
	end
	for _, t in ipairs(self.LogoTweens) do
		t:Cancel()
	end
	if self.TagGuis then
		for _, gui in pairs(self.TagGuis) do
			gui:Destroy()
		end
	end
	for _, c in ipairs(self.Connections) do
		c:Disconnect()
	end
	self.Gui:Destroy()
end

function UILibrary:SelectTab(tab)
	local theme = UILibrary.Theme
	for _, t in ipairs(self.Tabs) do
		local active = t == tab
		local wasActive = t.Active
		t.Active = active
		t.Page.Visible = active
		if active and not wasActive then
			t.Page.Position = UDim2.fromOffset(0, 14)
			tween(t.Page, { Position = UDim2.new() }, 0.25, Enum.EasingStyle.Quint)
		end
		tween(t.Button, { BackgroundTransparency = active and 0 or 1 })
		tween(t.Label, { TextColor3 = active and theme.Text or theme.SubText })
		tween(t.Indicator, { Size = UDim2.fromOffset(3, active and 16 or 0) }, 0.2)
		if t.Icon then
			tween(t.Icon, { ImageColor3 = active and theme.Accent or theme.SubText })
		end
	end
end

