--[[
	window:EnableCreditTags({
		{ Username = "Ultrlarp", Tag = "Script Maker" },
		{ Username = "zc0yx", Tag = "Lead Developer" },
	})
	Shows a floating tag above those players' heads (only for people running this script).
	Returns an object with :SetVisible(bool) and :Destroy().
]]
function UILibrary:EnableCreditTags(list, options)
	local lookup, byId = {}, {}
	for _, person in ipairs(list or {}) do
		if person.Username then lookup[string.lower(person.Username)] = person end
		if person.UserId then byId[person.UserId] = person end
	end

	self.TagGuis = self.TagGuis or {}
	local tags = self.TagGuis

	local function personFor(plr)
		return lookup[string.lower(plr.Name)] or byId[plr.UserId]
	end

	local function attach(plr, character)
		local person = personFor(plr)
		if not person then return end
		local head = character:WaitForChild("Head", 10)
		if not head or not self.Gui.Parent then return end
		if tags[plr] then tags[plr]:Destroy() end
		local gui = makeCreditTag(person)
		gui.Enabled = self.TagsEnabled
		gui.Adornee = head
		gui.Parent = head
		tags[plr] = gui
	end

	local function track(plr)
		if not personFor(plr) then return end
		table.insert(self.Connections, plr.CharacterAdded:Connect(function(character)
			attach(plr, character)
		end))
		if plr.Character then
			task.spawn(attach, plr, plr.Character)
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		track(plr)
	end
	table.insert(self.Connections, Players.PlayerAdded:Connect(track))
	table.insert(self.Connections, Players.PlayerRemoving:Connect(function(plr)
		if tags[plr] then
			tags[plr]:Destroy()
			tags[plr] = nil
		end
	end))

	return {
		SetVisible = function(_, on)
			self.TagsEnabled = on
			for _, gui in pairs(tags) do
				gui.Enabled = on
			end
		end,
		Destroy = function()
			for plr, gui in pairs(tags) do
				gui:Destroy()
				tags[plr] = nil
			end
		end,
	}
end

