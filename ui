function Tab:AddSlider(options)
	local theme = UILibrary.Theme
	local min, max = options.Min or 0, options.Max or 100
	local increment = options.Increment or 1
	local suffix = options.Suffix or ""
	local value = math.clamp(options.Default or min, min, max)
	local alpha = (value - min) / (max - min)

	local f = newElement(self, 56)
	newLabel(f, options.Name or "Slider", {
		Size = UDim2.new(1, -90, 0, 26),
		Position = UDim2.fromOffset(12, 6),
	})
	local valueLabel = newLabel(f, tostring(value) .. suffix, {
		Size = UDim2.fromOffset(70, 26),
		Position = UDim2.new(1, -82, 0, 6),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = theme.Accent,
		Font = theme.FontBold,
	})

	local track = create("Frame", {
		Size = UDim2.new(1, -24, 0, 6),
		Position = UDim2.fromOffset(12, 40),
		BackgroundColor3 = theme.Track,
		BorderSizePixel = 0,
		Parent = f,
	}, { round() })
	local fill = create("Frame", {
		Size = UDim2.fromScale(alpha, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	}, { round(), gradient(theme.AccentDark, theme.Accent) })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(alpha, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	}, { round(), stroke(theme.Accent, 2) })

	local api = {}
	function api:Set(v, silent)
		v = math.floor((v - min) / increment + 0.5) * increment + min
		v = math.clamp(math.floor(v * 10000 + 0.5) / 10000, min, max)
		value = v
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = tostring(v) .. suffix
		if not silent and options.Callback then
			task.spawn(options.Callback, v)
		end
	end
	function api:Get() return value end

	local dragging = false
	local function update(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		api:Set(min + (max - min) * a)
	end

	local function setDragging(state)
		dragging = state
		tween(knob, { Size = state and UDim2.fromOffset(18, 18) or UDim2.fromOffset(14, 14) }, 0.1)
	end

	f.InputBegan:Connect(function(input)
		if isPointer(input) then
			setDragging(true)
			update(input.Position.X)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					setDragging(false)
				end
			end)
		end
	end)
	hoverEffect(f, f, theme.Element, theme.ElementHover)
	table.insert(self.Window.Connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			update(input.Position.X)
		end
	end))

	return api
end

