local function textBlob(frame)
	local parts = {}
	for _, d in ipairs(frame:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			table.insert(parts, d.Text)
		end
	end
	return string.lower(table.concat(parts, " "))
end

-- Applies the search filter and collapsed sections to this tab's elements
function Tab:_refresh()
	local query = string.lower(self.Window.Query or "")
	local matches = 0
	for _, rec in ipairs(self.Records) do
		if rec.IsSection then
			rec.Section.HasMatch = false
		end
	end
	for _, rec in ipairs(self.Records) do
		if not rec.IsSection then
			local match = query == "" or string.find(textBlob(rec.Frame), query, 1, true) ~= nil
			local hidden = rec.Section ~= nil and rec.Section.Collapsed and query == ""
			rec.Frame.Visible = match and not hidden
			if match then
				matches += 1
				if rec.Section then rec.Section.HasMatch = true end
			end
		end
	end
	for _, rec in ipairs(self.Records) do
		if rec.IsSection then
			rec.Frame.Visible = query == "" or rec.Section.HasMatch
		end
	end
	self.MatchCount = matches
end

-- AddSection("Title", startCollapsed): click the header to collapse its elements
function Tab:AddSection(text, collapsed)
	local theme = UILibrary.Theme
	self.Order += 1
	local section = { Collapsed = collapsed == true, HasMatch = true }

	local f = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self.Order,
		Parent = self.Page,
	})
	newLabel(f, string.upper(text), {
		Position = UDim2.fromOffset(2, 0),
		Size = UDim2.new(1, -26, 1, -3),
		Font = theme.FontBold,
		TextSize = 11,
		TextColor3 = theme.Accent,
		TextYAlignment = Enum.TextYAlignment.Bottom,
	})
	local arrow = newLabel(f, "v", {
		Size = UDim2.fromOffset(20, 23),
		Position = UDim2.new(1, -22, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextColor3 = theme.SubText,
		Font = theme.FontBold,
		TextSize = 12,
		Rotation = section.Collapsed and -90 or 0,
	})
	create("Frame", {
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = theme.Stroke,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Parent = f,
	})

	table.insert(self.Records, { Frame = f, IsSection = true, Section = section })
	self.CurrentSection = section

	local api = {}
	function api:Set(state)
		section.Collapsed = state
		tween(arrow, { Rotation = state and -90 or 0 }, 0.15)
		self.Tab:_refresh()
	end
	api.Tab = self
	f.Activated:Connect(function()
		api:Set(not section.Collapsed)
	end)
	return api
end

