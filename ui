		TextSize = 15,
		LayoutOrder = 1,
	})
	newLabel(titleRow, options.Subtitle or "", {
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		TextColor3 = theme.SubText,
		TextSize = 12,
		LayoutOrder = 2,
	})

	local function winButton(text, xOffset, hoverColor, hoverText, callback)
		local b = create("TextButton", {
			Size = UDim2.fromOffset(26, 26),
			Position = UDim2.new(1, xOffset, 0.5, -13),
			BackgroundColor3 = hoverColor,
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = theme.SubText,
			Font = theme.FontBold,
			TextSize = 16,
			AutoButtonColor = false,
			Parent = topbar,
		}, { corner(6) })
		b.MouseEnter:Connect(function()
			tween(b, { BackgroundTransparency = 0, TextColor3 = hoverText })
		end)
		b.MouseLeave:Connect(function()
			tween(b, { BackgroundTransparency = 1, TextColor3 = theme.SubText })
		end)
		b.Activated:Connect(callback)
	end
	winButton("×", -36, theme.Error, Color3.new(1, 1, 1), function() self:Destroy() end)
	winButton("–", -66, theme.ElementHover, theme.Text, function() self:SetMinimized(not self.Minimized) end)

	makeDraggable(topbar, self.Root, self.Connections)

	-- Sidebar
	self.Sidebar = create("Frame", {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(0, 150, 1, -40),
		BackgroundColor3 = theme.Sidebar,
		BorderSizePixel = 0,
		Parent = self.Main,
	})
	create("Frame", {
