					end
				end
				keyBtn.Text = key.Name
				tween(keyStroke, { Color = theme.Stroke })
			end
			return
		end
		if not processed and input.KeyCode == key and options.Callback then
			task.spawn(options.Callback)
		end
	end))

	return {
		Get = function() return key end,
		Set = function(_, newKey, silent)
			key = newKey
			keyBtn.Text = newKey.Name
			if not silent and options.OnChanged then
				task.spawn(options.OnChanged, key)
			end
		end,
	}
end

function Tab:AddColorPicker(options)
	local theme = UILibrary.Theme
	local color = options.Default or Color3.fromRGB(255, 255, 255)
	local h, s, v = Color3.toHSV(color)
	local open = false
	local HEADER_H, BODY_H = 38, 132

	local f = newElement(self, HEADER_H)
	f.ClipsDescendants = true

	newLabel(f, options.Name or "Color", {
		Size = UDim2.new(1, -70, 0, HEADER_H),
		Position = UDim2.fromOffset(12, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local swatch = create("Frame", {
		Size = UDim2.fromOffset(34, 20),
		Position = UDim2.new(1, -46, 0, 9),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = f,
	}, { corner(5), stroke(theme.Stroke, 1) })

	local body = create("Frame", {
		Position = UDim2.fromOffset(12, HEADER_H),
		Size = UDim2.new(1, -24, 0, BODY_H),
		BackgroundTransparency = 1,
		Parent = f,
	})

	-- Saturation / value square
	local sv = create("Frame", {
		Size = UDim2.new(1, 0, 0, 108),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		Parent = body,
	}, { corner(6) })
	create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = sv,
	}, { corner(6), create("UIGradient", { Transparency = NumberSequence.new(0, 1) }) })
	create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = sv,
	}, { corner(6), create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }) })
	local svCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(s, 1 - v),
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = sv,
	}, { round(), stroke(Color3.new(1, 1, 1), 2) })

	-- Hue bar
	local keypoints = {}
	for i = 0, 6 do
		table.insert(keypoints, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
	end
	local hue = create("Frame", {
		Position = UDim2.fromOffset(0, 118),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = body,
	}, { corner(5), create("UIGradient", { Color = ColorSequence.new(keypoints) }) })
	local hueCursor = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(h, 0.5),
		Size = UDim2.fromOffset(4, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hue,
	}, { corner(2), stroke(Color3.new(0, 0, 0), 1) })

	local api = {}
	local function apply(silent)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.fromScale(h, 0.5)
		if not silent and options.Callback then
			task.spawn(options.Callback, color)
		end
	end
	function api:Get() return color end
	function api:Set(newColor, silent)
		h, s, v = Color3.toHSV(newColor)
		apply(silent)
	end

	local function updateSV(pos)
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		apply()
	end
	local function updateHue(pos)
		h = math.clamp((pos.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
		apply()
	end

	local mode
	local function begin(kind, updater)
		return function(input)
			if isPointer(input) then
				mode = kind
				updater(input.Position)
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						mode = nil
					end
				end)
			end
		end
	end
	sv.InputBegan:Connect(begin("sv", updateSV))
	hue.InputBegan:Connect(begin("hue", updateHue))
	table.insert(self.Window.Connections, UserInputService.InputChanged:Connect(function(input)
		if mode and isMove(input) then
			if mode == "sv" then
				updateSV(input.Position)
			else
				updateHue(input.Position)
			end
		end
	end))

	local function setOpen(state)
		open = state
		tween(f, { Size = UDim2.new(1, 0, 0, HEADER_H + (open and (BODY_H + 12) or 0)) }, 0.22, Enum.EasingStyle.Quint)
	end
	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, HEADER_H),
		BackgroundTransparency = 1,
		Text = "",
		Parent = f,
	})
	header.Activated:Connect(function()
		setOpen(not open)
	end)

	return api
end

