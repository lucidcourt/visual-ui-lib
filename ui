			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			Parent = f,
		}, { round(), stroke(theme.Accent, 1), pad(0, 0, 10, 10) })
		newLabel(pill, options.Tag, {
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = theme.FontBold,
			TextSize = 11,
			TextColor3 = theme.Accent,
		})
	end

	-- Load the avatar in the background
	task.spawn(function()
		local ok, userId = pcall(function()
			return options.UserId or Players:GetUserIdFromNameAsync(username)
		end)
		if not ok then return end
		local ok2, img = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok2 and avatar.Parent then
			avatar.Image = img
			initial.Visible = false
		end
	end)

	return f
end

-- Elements created with Flag = "name" remember their value in window.Flags, in case you want
-- to build your own save/load later. Nothing reads or writes this on its own.
for kind, method in pairs({
	toggle = "AddToggle",
	slider = "AddSlider",
	textbox = "AddTextBox",
	dropdown = "AddDropdown",
	keybind = "AddKeybind",
	color = "AddColorPicker",
}) do
	local original = Tab[method]
	Tab[method] = function(self, options)
		local api = original(self, options)
		if options and options.Flag then
			self.Window.Flags[options.Flag] = { api = api, kind = kind }
		end
		return api
	end
end

return UILibrary
end)()

