local function serifFont()
	local ok, font = pcall(function()
		return Enum.Font.Merriweather
	end)
	return ok and font or Enum.Font.GothamBold
end

-- Builds the Visual logo into `parent`: your image if given, otherwise a drawn
-- V with an orbit ring and a sparkle. Returns the holder frame.
local function buildLogo(parent, S, image, tweens)
	local theme = UILibrary.Theme
	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(S, S),
		Parent = parent,
	})
	if image and image ~= "" then
		create("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = image,
			ScaleType = Enum.ScaleType.Fit,
			Parent = holder,
		})
		return holder
	end

	local light = theme.Accent:Lerp(Color3.new(1, 1, 1), 0.25)

	local ringGradient = gradient(theme.AccentDark, light, 0)
	local ring = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.57),
		Size = UDim2.fromOffset(S * 1.12, S * 0.4),
		Rotation = -20,
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = holder,
	}, {
		round(),
		create("UIStroke", {
			Color = Color3.new(1, 1, 1),
			Thickness = math.max(2, S * 0.04),
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, { ringGradient }),
	})

	local v = newLabel(holder, "V", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.47),
		Size = UDim2.fromScale(1, 1),
		Font = serifFont(),
		TextSize = math.floor(S * 0.95),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
	})
	create("UIGradient", {
		Color = ColorSequence.new(light, theme.AccentDark),
		Rotation = 90,
		Parent = v,
	})

	local spark = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.92, 0.4),
		Size = UDim2.fromOffset(S * 0.2, S * 0.2),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = holder,
	})
	local thick = math.max(2, S * 0.03)
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, thick, 1, 0),
		BackgroundColor3 = light,
		BorderSizePixel = 0,
		Parent = spark,
	}, { round() })
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, thick),
		BackgroundColor3 = light,
		BorderSizePixel = 0,
		Parent = spark,
	}, { round() })
	local sparkScale = create("UIScale", { Scale = 0.7, Parent = spark })

	if tweens then
		local twinkle = TweenService:Create(
			sparkScale,
			TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Scale = 1.2 }
		)
		twinkle:Play()
		local sway = TweenService:Create(
			ring,
			TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Rotation = -15 }
		)
		sway:Play()
		table.insert(tweens, twinkle)
		table.insert(tweens, sway)
	end
	return holder
end

--[[
	local splash = UILibrary.Splash({
		Title = "Visual",
		Subtitle = "Preparing your experience",
		Steps = { "Loading assets", "Building interface", "Almost there" },
		Duration = 4,      -- length of the automatic progress (seconds)
		Manual = false,    -- true = you drive it: SetProgress / SetStatus, then Finish()
		Logo = nil,        -- image id; defaults to UILibrary.LogoImage, then the drawn logo
		Blur = true,       -- blur the 3D world behind the splash
		Skippable = true,
		Footer = "Made by ...",
		Version = "v7.0",
		Tips = { "Tip one", "Tip two" },
		Particles = 28,
		OnFinished = function() end,
	})
	splash:SetStatus("Loading map")   splash:SetProgress(0.5)
	splash:Finish()   splash:Skip()   splash:Wait()
]]
function UILibrary.Splash(options)
	options = options or {}
	local theme = UILibrary.Theme
	local Lighting = game:GetService("Lighting")
	local self = setmetatable({}, Splash)
	self.Options = options
	self.Alive = true
	self.Finished = false
	self.Finishing = false
	self.Skipped = false
	self.Tweens = {}
	self.Done = Instance.new("BindableEvent")

	local title = options.Title or "Visual"
	local player = Players.LocalPlayer

	self.Gui = create("ScreenGui", {
		Name = "VisualSplash",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	self.Root = create("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Active = true, -- blocks clicks behind the splash
		Parent = self.Gui,
	})
	local root = self.Root

	if options.Blur ~= false then
		self.Blur = create("BlurEffect", { Size = 0, Parent = Lighting })
	end

	-- Flame glow along the bottom edge
	local flame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(1, 0, 0, 320),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = root,
	}, {
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.55, 0.94),
				NumberSequenceKeypoint.new(1, 0.76),
			}),
		}),
	})
	local flameBreath = TweenService:Create(
		flame,
		TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Size = UDim2.new(1, 0, 0, 380) }
	)
	flameBreath:Play()
	table.insert(self.Tweens, flameBreath)

	-- Soft glow behind the logo (stacked circles, pulsing)
	local glow = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -88),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		Parent = root,
	})
	for i = 1, 8 do
		local d = 110 + i * 62
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(d, d),
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = 0.966,
			BorderSizePixel = 0,
			Parent = glow,
		}, { round() })
	end
	local glowScale = create("UIScale", { Parent = glow })
	local pulse = TweenService:Create(
		glowScale,
		TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Scale = 1.15 }
	)
	pulse:Play()
	table.insert(self.Tweens, pulse)

	-- Embers rising from the flames
	local emberColors = {
		theme.Accent,
		theme.Accent:Lerp(Color3.new(1, 1, 1), 0.35),
		Color3.fromRGB(255, 150, 105),
	}
	for _ = 1, (options.Particles or 28) do
		local sz = math.random(2, 5)
		local dot = create("Frame", {
			Size = UDim2.fromOffset(sz, sz),
			Position = UDim2.fromScale(math.random(), 1.02),
			BackgroundColor3 = emberColors[math.random(#emberColors)],
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = root,
		}, { round() })
		task.spawn(function()
			task.wait(math.random() * 5)
			while self.Alive do
				local x = math.random()
				dot.Position = UDim2.fromScale(x, 1.02)
				dot.BackgroundTransparency = 0.15
				local dur = 4 + math.random() * 5
				local rise = 0.35 + math.random() * 0.5
				tween(dot, {
					Position = UDim2.fromScale(math.clamp(x + (math.random() - 0.5) * 0.15, 0, 1), 1.02 - rise),
					BackgroundTransparency = 1,
				}, dur, Enum.EasingStyle.Linear)
				task.wait(dur)
			end
		end)
	end

	-- Logo
	local LOGO = 150
	local hero = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -88),
		Size = UDim2.fromOffset(LOGO, LOGO),
		BackgroundTransparency = 1,
		Parent = root,
	})
	self.HeroScale = create("UIScale", { Scale = 0.5, Parent = hero })
	buildLogo(hero, LOGO, options.Logo or UILibrary.LogoImage, self.Tweens)

	-- Title (letter-spaced, typed out) + subtitle
	local spaced = {}
	for _, code in utf8.codes(title) do
		table.insert(spaced, utf8.char(code))
	end
	local spacedTitle = string.upper(table.concat(spaced, " "))
	local titleLabel = newLabel(root, spacedTitle, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 6),
		Size = UDim2.fromOffset(420, 34),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = theme.FontBold,
		TextSize = 26,
		MaxVisibleGraphemes = 0,
	})
	local subtitle = newLabel(root, options.Subtitle or "", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 44),
		Size = UDim2.fromOffset(420, 20),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = theme.SubText,
		TextSize = 14,
		TextTransparency = 1,
	})

	-- Progress bar
	local track = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 86),
		Size = UDim2.fromOffset(300, 5),
		BackgroundColor3 = theme.Track,
		BorderSizePixel = 0,
		Parent = root,
	}, { round() })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = track,
	}, { round(), gradient(theme.AccentDark, theme.Accent:Lerp(Color3.new(1, 1, 1), 0.2)) })
	local shimmer = create("Frame", {
		Position = UDim2.fromScale(-0.4, 0),
		Size = UDim2.fromScale(0.4, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = fill,
	}, {
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	local shimmerTween = TweenService:Create(
		shimmer,
		TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
		{ Position = UDim2.fromScale(1.1, 0) }
	)
	shimmerTween:Play()
	table.insert(self.Tweens, shimmerTween)

	self.Status = newLabel(root, options.Steps and options.Steps[1] or "Loading...", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 98),
		Size = UDim2.fromOffset(300, 18),
		TextColor3 = theme.SubText,
		TextSize = 12,
	})
	self.StatusText = self.Status.Text
	local percent = newLabel(root, "0%", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 98),
		Size = UDim2.fromOffset(300, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = theme.FontBold,
		TextColor3 = theme.Accent,
		TextSize = 12,
	})

	local tipLabel
	if options.Tips and #options.Tips > 0 then
		tipLabel = newLabel(root, "", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.5, 136),
			Size = UDim2.fromOffset(420, 34),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextColor3 = theme.SubText,
			TextSize = 12,
			TextTransparency = 1,
		})
	end

	self.Num = Instance.new("NumberValue")
	self.Num.Changed:Connect(function(v)
		fill.Size = UDim2.fromScale(v, 1)
		percent.Text = string.format("%d%%", math.floor(v * 100 + 0.5))
	end)

	-- Footer, version, skip
	if options.Footer then
		newLabel(root, options.Footer, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -22),
			Size = UDim2.fromOffset(500, 18),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = theme.SubText,
			TextSize = 12,
		})
	end
	if options.Version then
		newLabel(root, options.Version, {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 20, 1, -26),
			Size = UDim2.fromOffset(200, 18),
			TextColor3 = theme.SubText,
			TextSize = 12,
		})
	end
	if options.Skippable ~= false then
		local skip = create("TextButton", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -20, 1, -20),
			Size = UDim2.fromOffset(70, 30),
			BackgroundColor3 = theme.Element,
			Text = "Skip",
			TextColor3 = theme.SubText,
			Font = theme.Font,
			TextSize = 13,
			AutoButtonColor = false,
			Parent = root,
		}, { corner(8), stroke(theme.Stroke, 1) })
		hoverEffect(skip, skip, theme.Element, theme.ElementHover)
		skip.Activated:Connect(function()
			self:Skip()
		end)
	end

	-- Sequence
	local function sleep(t)
		local e = 0
		while e < t and self.Alive and not self.Skipped do
			e += task.wait(0.03)
		end
	end

	task.spawn(function()
		tween(root, { GroupTransparency = 0 }, 0.4)
		if self.Blur then tween(self.Blur, { Size = 20 }, 0.6) end
		tween(self.HeroScale, { Scale = 1 }, 0.8, Enum.EasingStyle.Back)
		task.wait(0.3)

		local len = utf8.len(spacedTitle) or #spacedTitle
		for i = 1, len do
			if not self.Alive then return end
			titleLabel.MaxVisibleGraphemes = i
			task.wait(0.04)
		end
		if not self.Alive then return end
		tween(subtitle, { TextTransparency = 0 }, 0.4)

		if tipLabel then
			task.spawn(function()
				local i = 0
				while self.Alive and not self.Finishing do
					i = i % #options.Tips + 1
					tipLabel.Text = options.Tips[i]
					tween(tipLabel, { TextTransparency = 0.15 }, 0.3)
					task.wait(2.4)
					tween(tipLabel, { TextTransparency = 1 }, 0.3)
					task.wait(0.35)
				end
			end)
		end

		if options.Manual then return end

		local steps = options.Steps or { "Loading assets", "Preparing interface", "Almost there" }
		local n = #steps
		local duration = options.Duration or 3.5
		for i, text in ipairs(steps) do
			if self.Skipped or not self.Alive then break end
			self:SetStatus(text)
			local share = (duration / n) * (0.75 + math.random() * 0.5)
			self:SetProgress(i / n, share)
			sleep(share)
		end
		self:Finish()
	end)

	return self
end

function Splash:SetProgress(alpha, duration)
	if not self.Alive then return end
	return tween(self.Num, { Value = math.clamp(alpha, 0, 1) }, duration or 0.35)
end

function Splash:SetStatus(text)
	if not self.Alive or self.StatusText == text then return end
	self.StatusText = text
	task.spawn(function()
		tween(self.Status, { TextTransparency = 1 }, 0.12)
		task.wait(0.12)
		if not self.Alive then return end
		self.Status.Text = text
		tween(self.Status, { TextTransparency = 0 }, 0.12)
	end)
end

function Splash:Skip()
	self.Skipped = true
	self:Finish()
end

function Splash:Finish()
	if self.Finishing or not self.Alive then return end
	self.Finishing = true
	task.spawn(function()
		local quick = self.Skipped
		self:SetProgress(1, quick and 0.15 or 0.35)
		self:SetStatus(quick and "Skipping..." or (self.Options.ReadyText or ("Welcome, " .. Players.LocalPlayer.DisplayName)))
		task.wait(quick and 0.25 or 0.95)
		if not self.Alive then return end

		self.Finished = true
		self.Done:Fire()
		if self.Options.OnFinished then
			task.spawn(self.Options.OnFinished)
		end

		tween(self.HeroScale, { Scale = 1.15 }, 0.45)
		tween(self.Root, { GroupTransparency = 1 }, 0.45)
		if self.Blur then tween(self.Blur, { Size = 0 }, 0.45) end
		task.wait(0.5)
		self:Destroy()
	end)
end

function Splash:Wait()
	if not self.Finished then
		self.Done.Event:Wait()
	end
end

function Splash:Destroy()
	if not self.Alive then return end
	self.Alive = false
	for _, t in ipairs(self.Tweens) do
		t:Cancel()
	end
	if self.Blur then self.Blur:Destroy() end
	if self.Num then self.Num:Destroy() end
	if self.Gui then self.Gui:Destroy() end
	if not self.Finished then
		self.Finished = true
		self.Done:Fire()
	end
end

