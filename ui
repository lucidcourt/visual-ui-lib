		hoverEffect(
			b, b,
			info.Primary and theme.Accent or theme.Element,
			info.Primary and theme.AccentDark or theme.ElementHover
		)
		b.Activated:Connect(function()
			close()
			if info.Callback then
				task.spawn(info.Callback, inputBox and inputBox.Text or nil)
			end
		end)
	end

	tween(overlay, { BackgroundTransparency = 0.45 }, 0.2)
	tween(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
	return { Close = close }
