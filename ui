	end
	return tab
end

--[[ Notify({ Title = "Hi", Content = "Hello!", Duration = 4, Type = "Success" })  (click a toast to dismiss it) ]]
function UILibrary:Notify(options)
	local theme = UILibrary.Theme
	options = options or {}
	if self.LogTab then
		self.LogTab:AddInfo({ Name = options.Title or "Notice", Value = os.date("%H:%M:%S") })
	end
	local color = theme[options.Type or "Accent"]
	if typeof(color) ~= "Color3" then color = theme.Accent end
	local duration = options.Duration or 4
	local content = options.Content or ""

	local textH = TextService:GetTextSize(content, 12, theme.Font, Vector2.new(250, 1000)).Y
	local height = math.max(60, 32 + textH + 12)

	local wrapper = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Parent = self.NotifyHolder,
	})
	local card = create("Frame", {
		Position = UDim2.new(1, 40, 0, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Topbar,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = wrapper,
	}, { corner(8), stroke(theme.Stroke, 1) })

	create("Frame", {
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = card,
	})
	newLabel(card, options.Title or "Notice", {
		Position = UDim2.fromOffset(14, 7),
		Size = UDim2.new(1, -24, 0, 18),
		Font = theme.FontBold,
	})
	newLabel(card, content, {
		Position = UDim2.fromOffset(14, 27),
		Size = UDim2.new(1, -24, 0, textH),
		TextColor3 = theme.SubText,
		TextSize = 12,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local bar = create("Frame", {
		Position = UDim2.new(0, 0, 1, -2),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = card,
	})

	local dismissed = false
	local function dismiss()
		if dismissed or not card.Parent then return end
		dismissed = true
		local t = tween(card, { Position = UDim2.new(1, 40, 0, 0) }, 0.25)
		t.Completed:Wait()
		wrapper:Destroy()
	end

	local click = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = card,
	})
	click.Activated:Connect(function()
		task.spawn(dismiss)
	end)

	tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.35, Enum.EasingStyle.Back)
	tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
	task.delay(duration, dismiss)

	return { Dismiss = dismiss }
end

--[[
