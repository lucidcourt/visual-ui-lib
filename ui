--[[
	AddDropdown({
		Name = "Mode", Options = { "A", "B" }, Default = "A", Callback = function(value) end,
		Multi = true,  -- optional: multi-select. Default is a list, callback receives a list.
	})
]]
function Tab:AddDropdown(options)
	local theme = UILibrary.Theme
	local items = options.Options or {}
	local multi = options.Multi == true
	local selected = nil
	local chosen = {}
	if multi then
		for _, v in ipairs(type(options.Default) == "table" and options.Default or {}) do
			chosen[v] = true
		end
	else
		selected = options.Default
	end
	local open = false
	local ITEM_H, GAP, HEADER_H = 28, 4, 38
	local listHeight = 0

	local function isSelected(item)
		if multi then
			return chosen[item] == true
		end
		return item == selected
	end

	local function summary()
		if multi then
			local names = {}
			for _, item in ipairs(items) do
				if chosen[item] then table.insert(names, tostring(item)) end
			end
			if #names == 0 then return "None" end
			if #names <= 2 then return table.concat(names, ", ") end
			return #names .. " selected"
		end
		return selected ~= nil and tostring(selected) or "Select..."
	end

	local f = newElement(self, HEADER_H)
	f.ClipsDescendants = true

	newLabel(f, options.Name or "Dropdown", {
		Size = UDim2.new(0.5, -12, 0, HEADER_H),
		Position = UDim2.fromOffset(12, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local current = newLabel(f, summary(), {
		Size = UDim2.new(0.5, -38, 0, HEADER_H),
		Position = UDim2.new(0.5, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = theme.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local arrow = newLabel(f, "v", {
		Size = UDim2.fromOffset(20, HEADER_H),
		Position = UDim2.new(1, -30, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = theme.SubText,
		Font = theme.FontBold,
	})

	local list = create("Frame", {
		Position = UDim2.fromOffset(8, HEADER_H),
		Size = UDim2.new(1, -16, 0, 0),
		BackgroundTransparency = 1,
		Parent = f,
	}, { create("UIListLayout", { Padding = UDim.new(0, GAP) }) })

	local buttons = {}
	local api = {}

	local function setOpen(state)
		open = state
		local height = HEADER_H + (open and (listHeight + 4) or 0)
		tween(f, { Size = UDim2.new(1, 0, 0, height) }, 0.22, Enum.EasingStyle.Quint)
		tween(arrow, { Rotation = open and 180 or 0 }, 0.22)
	end

	local function refreshVisuals()
		current.Text = summary()
		for item, b in pairs(buttons) do
			b.TextColor3 = isSelected(item) and theme.Accent or theme.Text
		end
	end

	function api:Get()
		if multi then
			local out = {}
			for _, item in ipairs(items) do
				if chosen[item] then table.insert(out, item) end
			end
			return out
		end
		return selected
	end

	function api:Set(value, silent)
		if multi then
			chosen = {}
			for _, v in ipairs(type(value) == "table" and value or {}) do
				chosen[v] = true
			end
		else
			selected = value
		end
		refreshVisuals()
		if not silent and options.Callback then
			task.spawn(options.Callback, api:Get())
		end
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		table.clear(buttons)
		listHeight = #items * (ITEM_H + GAP)
		list.Size = UDim2.new(1, -16, 0, listHeight)
		for _, item in ipairs(items) do
			local opt = create("TextButton", {
				Size = UDim2.new(1, 0, 0, ITEM_H),
				BackgroundColor3 = theme.ElementHover,
				Text = tostring(item),
				TextColor3 = isSelected(item) and theme.Accent or theme.Text,
				Font = theme.Font,
				TextSize = 13,
				AutoButtonColor = false,
				Parent = list,
			}, { corner(6) })
			buttons[item] = opt
			hoverEffect(opt, opt, theme.ElementHover, theme.Track)
			opt.Activated:Connect(function()
				if multi then
					chosen[item] = not chosen[item] or nil
					refreshVisuals()
					if options.Callback then
						task.spawn(options.Callback, api:Get())
					end
				else
					api:Set(item)
					setOpen(false)
				end
			end)
		end
		if open then setOpen(true) end
	end

	-- Replace the option list at runtime
	function api:Refresh(newItems)
		items = newItems or {}
		if multi then
			for k in pairs(chosen) do
				if not table.find(items, k) then chosen[k] = nil end
			end
		elseif selected ~= nil and not table.find(items, selected) then
			selected = nil
		end
		refreshVisuals()
		build()
	end

	build()

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, HEADER_H),
		BackgroundTransparency = 1,
		Text = "",
		Parent = f,
	})
	header.Activated:Connect(function()
		setOpen(not open)
	end)

	return api
end

