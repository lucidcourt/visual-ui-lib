-- Call before UILibrary.new(). Accepts a preset name or a table of overrides.
function UILibrary.SetTheme(nameOrTable)
	local overrides = type(nameOrTable) == "string" and UILibrary.Themes[nameOrTable] or nameOrTable
	if type(overrides) ~= "table" then return end
	for k, v in pairs(DEFAULT_THEME) do
		UILibrary.Theme[k] = v
	end
	for k, v in pairs(overrides) do
		UILibrary.Theme[k] = v
	end
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------

local function create(class, props, children)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	for _, child in ipairs(children or {}) do
		child.Parent = obj
	end
	return obj
end

local function tween(obj, props, time, style, dir)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

local function round()
	return create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

local function stroke(color, thickness)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function gradient(c1, c2, rotation)
	return create("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rotation or 0,
	})
end

local function pad(top, bottom, left, right)
	bottom = bottom or top
	left = left or top
	right = right or left
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		PaddingRight = UDim.new(0, right),
	})
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function hoverEffect(trigger, target, base, over)
	local st = target:FindFirstChildOfClass("UIStroke")
	local baseStroke = st and st.Color
	local hoverStroke = baseStroke and baseStroke:Lerp(UILibrary.Theme.Accent, 0.55)
	trigger.MouseEnter:Connect(function()
		tween(target, { BackgroundColor3 = over }, 0.12)
		if st then tween(st, { Color = hoverStroke }, 0.12) end
	end)
	trigger.MouseLeave:Connect(function()
		tween(target, { BackgroundColor3 = base }, 0.12)
		if st then tween(st, { Color = baseStroke }, 0.12) end
	end)
end

local function makeDraggable(handle, target, connections)
	local dragging, dragStart, startPos

	handle.InputBegan:Connect(function(input)
		if isPointer(input) then
			dragging = true
			dragStart = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end))
end

local function newLabel(parent, text, props)
	local theme = UILibrary.Theme
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = theme.Text,
		Font = theme.Font,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	return label
end

-- Base card for every element. Pass nil height for auto-sizing.
local function newElement(tab, height)
	local theme = UILibrary.Theme
	tab.Order += 1
	local f = create("Frame", {
		Size = UDim2.new(1, 0, 0, height or 0),
		AutomaticSize = height and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		LayoutOrder = tab.Order,
		Parent = tab.Page,
	}, { corner(8), stroke(theme.Stroke, 1) })
	local rec = { Frame = f, Section = tab.CurrentSection }
	table.insert(tab.Records, rec)
	if rec.Section and rec.Section.Collapsed then
		f.Visible = false
	end
	return f
end

-- Name (and optional description) on the left of an element card
local function nameBlock(f, name, desc, rightPad)
	local theme = UILibrary.Theme
	if desc then
		local main = newLabel(f, name, {
			Size = UDim2.new(1, -rightPad, 0, 18),
			Position = UDim2.fromOffset(12, 8),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		newLabel(f, desc, {
			Size = UDim2.new(1, -rightPad, 0, 16),
			Position = UDim2.fromOffset(12, 27),
			TextColor3 = theme.SubText,
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		return main
	end
	return newLabel(f, name, {
		Size = UDim2.new(1, -rightPad, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

